# Spotify Developer app (dashboard.spotify.com/dashboard -> Create app).
# Authorization Code + PKCE flow — only the Client ID is needed, no secret.
SPOTIFY_CLIENT_ID=

# GetSongBPM.com API key (free signup: https://getsongbpm.com/api)
GETSONGBPM_API_KEY=

# Signs the session cookie (holds your Spotify tokens) so it can't be forged or read by
# other sites. Any long random string — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Local dev only — ignored on Netlify (function has no fixed port).
PORT=3000

# Only needed when deploying (Netlify, Render, etc). Must exactly match a Redirect URI
# registered in the Spotify dashboard, and must be https:// for anything but 127.0.0.1.
# Example: https://your-app.netlify.app/callback
# SPOTIFY_REDIRECT_URI=
