# Spotify Developer app credentials (dashboard.spotify.com/dashboard -> Create app)
# Client Credentials flow only — no user login needed, works for reading public playlists
# even on apps created after Nov 2024 (audio-features is blocked, but this app doesn't use it).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# GetSongBPM.com API key (free signup: https://getsongbpm.com/api)
GETSONGBPM_API_KEY=

PORT=3000
